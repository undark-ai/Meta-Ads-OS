{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Run",
  "type": "object",
  "required": [
    "agent_id",
    "section",
    "status",
    "started_at"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "ready",
        "running",
        "completed",
        "blocked",
        "skipped",
        "failed",
        "invalid_output"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "section": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "coverage_contribution": {
      "enum": [
        "FINDINGS",
        "CLEAN",
        "DEGRADED",
        "N/A",
        "BLOCKED",
        null
      ]
    },
    "lane": {
      "enum": [
        "audit",
        "execution"
      ],
      "default": "audit"
    }
  },
  "description": "One agent's execution record within a run. 'skipped' and 'blocked' are different outcomes and both are reportable: skipped means the agent's layer does not exist in this account, blocked means an input was unreachable."
}